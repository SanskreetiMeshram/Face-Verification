# =================================================================
# FaceChain Verify - Environment Configuration Template
# =================================================================

# 1. Reverse Search Provider Configuration
# Supported providers: serpapi, bing, rapidapi, tineye, demo
REVERSE_SEARCH_PROVIDER=serpapi
REVERSE_SEARCH_API_KEY=

# Optional Provider Engine (e.g. google_lens, google_reverse_image)
SERPAPI_ENGINE=google_lens
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch
RAPIDAPI_HOST=google-lens-reverse-image-search.p.rapidapi.com
ALLOW_DEMO_FALLBACK=true

# 2. Blockchain Configuration (Local Hardhat or Ethereum Testnet)
CHAIN_ID=31337
CHAIN_NAME=Local Hardhat Network
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

# 3. Server & CORS Settings
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
