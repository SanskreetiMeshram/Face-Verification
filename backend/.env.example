# =================================================================
# FaceChain Verify - Backend Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Reverse Image Search Configuration
# -----------------------------------------------------------------
# Supported Providers:
#   - serpapi           (Google Lens / Google Reverse Image via SerpApi - Recommended)
#   - bing              (Bing Visual Search API via Azure Cognitive Services)
#   - rapidapi          (RapidAPI Google Lens / Reverse Search endpoints)
#   - tineye            (TinEye Commercial API)
#   - searxng           (Self-hosted / Public SearXNG instance)
#   - demo              (Strictly for offline local development demo mode)
REVERSE_IMAGE_PROVIDER=serpapi
REVERSE_IMAGE_API_KEY=your_serpapi_or_provider_api_key_here

# Provider-specific optional settings
SERPAPI_ENGINE=google_lens
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch
RAPIDAPI_HOST=google-lens-reverse-image-search.p.rapidapi.com
SEARXNG_URL=http://localhost:8080

# Demo mode fallback flag (Defaults to False. If True and no API key is set, allows labeled mock demonstration)
ALLOW_DEMO_FALLBACK=true

# -----------------------------------------------------------------
# 2. Blockchain Configuration (Polygon Amoy Testnet default)
# -----------------------------------------------------------------
# Chain ID: 80002 for Polygon Amoy, 11155111 for Ethereum Sepolia, 1337/31337 for Local
CHAIN_ID=80002
CHAIN_NAME=Polygon Amoy Testnet
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# Backend signing wallet private key (NEVER EXPOSE IN FRONTEND OR GIT)
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=your_wallet_private_key_hex_here

# Deployed FaceMatchRegistry Smart Contract address on Polygon Amoy
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------
# 3. Server & Security Settings
# -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
TEMP_UPLOAD_DIR=app/temp_uploads
